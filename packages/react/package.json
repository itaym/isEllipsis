{
  "name": "@isellipsis/react",
  "version": "3.0.2",
  "description": "React hook for detecting whether an element is truncating its text with an ellipsis",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "ellipsis",
    "truncation",
    "text-overflow",
    "react",
    "hook",
    "tooltip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itaym/isEllipsis.git",
    "directory": "packages/react"
  },
  "author": "Itay Merchav",
  "license": "MIT",
  "dependencies": {
    "isellipsis": "^3.0.2"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "publishConfig": {
    "access": "public"
  }
}
