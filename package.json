{
  "name": "isellipsis-monorepo",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "description": "Find out if an HTML element is truncating its text with an ellipsis",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "build": "npm run build --workspace @isellipsis/core && npm run build --workspace @isellipsis/react",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/react && tsc --noEmit -p playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run playground:build && playwright test",
    "playground": "npm run dev --workspace playground",
    "playground:build": "npm run build --workspace playground",
    "playground:preview": "npm run preview --workspace playground",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"playground/src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"playground/src/**/*.{ts,tsx}\" \"e2e/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itaym/isEllipsis.git"
  },
  "author": "Itay Merchav",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/itaym/isEllipsis/issues"
  },
  "homepage": "https://github.com/itaym/isEllipsis#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "happy-dom": "^20.14.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
